[Unit]
Description=Halo Mesh Networking
After=network.target dhcpcd.service
Wants=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/halo/halo
ExecStart=/home/halo/halo/start_mesh_safe.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
