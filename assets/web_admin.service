[Unit]
Description=Halo Web Admin Panel
Documentation=file:///home/pi/README.md
After=network-online.target
Wants=network-online.target
PartOf=halo.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi
ExecStart=/usr/bin/env python3 /home/pi/web_admin.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=halo-web-admin
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
